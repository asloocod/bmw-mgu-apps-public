{
  "id": "vr-warmup",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Прогрев двигателя",
  "description": "Синий термометр на приборке, пока мотор заведён и масло холоднее 80 °C. Рисует через Cluster renderer (нужна своя сцена у panel, см. README), машину только читает.",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "cluster-render": "0.4.1",
    "mgu-deploy": "0.4.0"
  },
  "uninstallable": true,
  "files": [
    {
      "path": "cluster.js",
      "from": "cluster.js",
      "mode": "0644"
    },
    {
      "path": "config.js",
      "from": "config.js",
      "mode": "0644"
    },
    {
      "path": "eventlog.js",
      "from": "eventlog.js",
      "mode": "0644"
    },
    {
      "path": "icon.js",
      "from": "icon.js",
      "mode": "0644"
    },
    {
      "path": "main.js",
      "from": "main.js",
      "mode": "0644"
    },
    {
      "path": "oapgen.js",
      "from": "oapgen.js",
      "mode": "0644"
    },
    {
      "path": "signal.js",
      "from": "signal.js",
      "mode": "0644"
    },
    {
      "path": "someip.js",
      "from": "someip.js",
      "mode": "0644"
    },
    {
      "path": "warmup.js",
      "from": "warmup.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE.idrive7-apps",
      "from": "LICENSE.idrive7-apps",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "vr-warmup.service",
      "from": "vr-warmup.service"
    }
  ],
  "enable": [
    {
      "unit": "vr-warmup.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "vr-warmup"
  ],
  "restart": [
    "vr-warmup.service"
  ]
}
