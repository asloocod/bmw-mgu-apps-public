[Unit]
Description=vr-warmup: engine warm-up icon on the instrument cluster (drawn by cluster-render)
After=cluster-render.socket
Wants=cluster-render.socket

[Service]
# root: the vsomeip policy lets uid 0 subscribe to CDS and VehicleInformation. Reads the car only.
# /run/vr-warmup/someip: the interface configs made at each start from MainApp's generator
RuntimeDirectory=vr-warmup
ExecStart=/usr/bin/node /var/opt/vr-warmup/current/main.js
# the unit's system.conf sends stdout nowhere by default: the log would never reach the journal
StandardOutput=journal
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
